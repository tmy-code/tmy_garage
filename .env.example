# Copy to .env for local development. Placeholder values only: never put real hostnames or secrets in this file.
PORT=3000
DATA_DIR=./data
# Optional: the hour (server time, see TZ) when the daily Reminders go out. Default 9.
REMINDER_HOUR=9
# Optional: how push services can reach whoever runs the server (a mailto: or https: address). Defaults to the project page.
# PUSH_CONTACT=mailto:someone@example.com
