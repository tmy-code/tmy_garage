{
  "name": "tmy_garage",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch src/server/main.ts",
    "dev:client": "vite",
    "build": "vite build",
    "start": "node src/server/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "notion-sync": "node --env-file-if-exists=.env src/notion/sync.ts",
    "build:android": "vite build --mode android && cap sync android"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.4",
    "hono": "^4.8.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@capacitor-community/file-opener": "8.0.1",
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/browser": "8.0.5",
    "@capacitor/cli": "8.5.3",
    "@capacitor/core": "8.5.3",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.4",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.2",
    "concurrently": "^9.2.0",
    "idb-keyval": "^6.2.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "simple-icons": "^16.36.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^5.1.0"
  }
}
